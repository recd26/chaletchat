# Dockerfile pour Paperclip sur Railway/Render/DigitalOcean

FROM node:22-alpine

WORKDIR /app

# Installer git (requis pour Paperclip)
RUN apk add --no-cache git bash

# Installer Paperclip globalement
RUN npm install -g paperclipai@latest

# Installer Claude Code CLI pour les agents
RUN npm install -g @anthropic-ai/claude-code

# Créer le dossier de configuration
RUN mkdir -p /root/.paperclip

# Exposer le port
EXPOSE 3100

# Volume pour la persistance (secrets, storage local)
VOLUME ["/root/.paperclip"]

# Variables d'environnement par défaut
ENV NODE_ENV=production
ENV PORT=3100

# Lancer Paperclip
CMD ["npx", "paperclipai", "run", "--bind", "0.0.0.0"]
